---
import { getCollection } from 'astro:content';
import Post from '../../../components/Post.astro';
import Layout from '../../../layouts/Layout.astro';
import Main from '../../../components/Main.astro';
import H1 from '../../../components/H1.astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { render } from 'astro:content';

export const getStaticPaths = async () => {
    const posts = await getCollection("posts");
    const paths = posts.map(post => {
        const [lang, ...slug] = post.id.split('/');
        return {
            params: {
                lang,
                slug: slug.join('/') || undefined
            },
            props: {
                post
            }
        }
    })
    return paths;
}

type Props = {
    post: CollectionEntry<"posts">
}

const {post} = Astro.props;
const {Content} = await render(post);
---

<Layout title={post.data.title}>
    <Main>
        <H1 text={post.data.title}></H1>
        <div class="tags flex mb-2">
            {post.data.categories.map((tag: string) => (
            <p ><a href={`/en/tags/${tag}`} class="tag rounded-2xl text-gray-50 bg-amber-600 dark:bg-emerald-500 h-9 w-fit px-2 py-1 m-2 overflow-hidden whitespace-nowrap">{tag}</a></p>
            ))}
        </div>
        <Image
            src={post.data.image}
            width={1024}
            height={600 / 1.0}
            alt={post.data.title}
            class="rounded-2xl shadow-xl mb-4 aspect-thumnail object-cover"
        />
        <div class="md:prose xl:prose-xl sm:prose lg:prose-lg dark:prose-dark max-w-none! break-after-auto overflow-visible relative [&>h3]:dark:text-gray-200 [&>ol]:dark:text-zinc-500 [&>strong]:dark:text-white [&>p>strong]:dark:text-white [&>ol>li>strong]:dark:text-white [&>h4]:dark:text-gray-400 m-0!">
            <Content/>
        </div>
    </Main>
</Layout>
---
import H1 from '../../components/H1.astro';
import Main from '../../components/Main.astro';
import Layout from '../../layouts/Layout.astro';

const pageTitle = "About Me";

const identity = {
  firstName: "André",
  country: "Brasil",
  occupation: "Desenvolvedor",
  hobbies: ["arte", "música", "jogos"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];

---

<Layout title={pageTitle}>
	<Main>
		<H1 text={pageTitle}/>
        <p>Oi eu sou o {identity.firstName}!! Prazer em conhecê-lo!!</p>
    <h2 class="text-left text-4xl font-bold">Algumas habilidades minhas são:</h2>
        <section class="carousel">

            <div class="container-fluid px-0">
                <div class="row">
                <div class="col-12">
                    <div class="carousel__wrapper">

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/html-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/css3-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/javascript-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/react-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/astro-logo-light-gradient.png');"></div>
                    </div>

                    <!--#### repeat ####-->
                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/html-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/css3-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/javascript-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/react-logo.png');"></div>
                    </div>

                    <div class="carousel__slide">
                        <div class="carousel__image" style="background-image: url('/images/astro-logo-light-gradient.png"></div>
                    </div>
                    </div>
                </div>
                </div>
            </div>
            </section>
	<Main>
</Layout>

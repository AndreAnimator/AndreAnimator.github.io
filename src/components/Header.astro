---
import ThemeDropdown from "./theme-dropdown.astro"
import ThemeHeadScript from "./theme-head-script.astro";
import LanguagePicker from '../components/LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from 'astro-icon/components';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
<li><a href={`/${lang}/`} class="text-teal-900 font-bold block py-2 px-3 rounded md:p-0 hover:text-teal-200">{t('nav.home')}</a></li>
            <li><a href={`/${lang}/about`} class="text-teal-900 font-bold block py-2 px-3 rounded md:p-0 hover:text-teal-200">{t('nav.about')}</a></li>
            <li><a href={`/${lang}/blog`} class="text-teal-900 font-bold block py-2 px-3 rounded md:p-0 hover:text-teal-200">Blog</a></li>
*/

const menuitems = [
  {
    title: t('nav.home'),
    path: `/${lang}/`,
    id: "home",
  },
  {
    title: t('nav.about'),
    path: `/${lang}/about`,
    id: "about",
  },
  {
    title: "Blog",
    path: `/${lang}/blog`,
    id: "blog",
  },
  {
    title: "Portfolio",
    path: `/${lang}/portfolio`,
    id: "portfolio",
  },
];

---

<header
    class="flex flex-col min-h-fit lg:flex-row justify-center items-center lg:py-5 background-light dark:background-dark border-b-10 border-amber-600 dark:border-emerald-500 dark:bg-gray-800"
  onload="activate()"
>
  <Astronav>
    <div class="my-5 flex flex-col items-center justify-between lg:flex-row">
      <a href=`/${lang}/` class="flex w-full lg:w-auto items-center justify-between text-lg lg:px-3 mt-5 mb-3 ml-5">
        <img
            src="/logo.webp"
            width={60}
            height={60}
            alt="Heartbeat icon"
            class="rounded-2xl aspect=thumbnail object-cover"
        />
        <span class="font-bold text-slate-800 dark:text-slate-300 flex wave-container wave-text">
          <span class="">C</span><span class="relative animate-spin">o</span><span class="relative animate-spin">d</span><span class="relative animate-spin">i</span><span class="relative animate-spin">n</span><span class="relative animate-spin">g</span>
        </span>
        <span class="flex text-slate-500 spin-container spin-text">
          <span>B</span><span>L</span><span>O</span><span>G</span>
        </span>
      </a>
      <div class="block lg:hidden text-lg mr-5 lg:w-auto">
        <MenuIcon class="w-10 h-10 px-3 py-3 text-gray-800 dark:text-gray-50 hover:text-gray-500 dark:hover:text-gray-300 bg-white hover:bg-amber-300 dark:bg-gray-800 dark:hover:bg-emerald-900 rounded-2xl" />
      </div>
    </div>
    <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0 lg:h-auto lg:px-0 max-lg:bg-white max-md:dark:bg-gray-800 max-lg:border-amber-600 max-lg:dark:border-emerald-500 max-lg:border-y-5">
        <ul class="flex flex-col lg:flex-row lg:gap-3 text-teal-900">
          {
            menuitems.map((item, index) => (
              <>
                <li>
                  <a
                    href={item.path}
                    class="flex font-bold px-3 py-3 text-gray-800 dark:text-gray-50 hover:text-gray-500 dark:hover:text-gray-300 bg-white hover:bg-amber-300 dark:bg-gray-800 dark:hover:bg-emerald-900 rounded-2xl max-lg:rounded-none" id={item.id}>
                    {item.title}
                  </a>
                </li>
              </>
            ))
          }
          <li><a href="https://andreanimator.github.io/rss" class="flex px-3 py-4 text-gray-800 dark:text-gray-50 hover:text-gray-500 dark:hover:text-gray-300 bg-white hover:bg-amber-300 dark:bg-gray-800 dark:hover:bg-emerald-900 rounded-2xl max-lg:rounded-none"><Icon name="feather:rss"></Icon></a></li>
          <li><div class=""><ThemeDropdown></ThemeDropdown></div></li>
          <li><LanguagePicker></LanguagePicker></li>
        </ul>
      </MenuItems>
  </Astronav>
</header>
<script>
  document.addEventListener("astro:page-load", () => {
    console.log("Alou");
    function activate() {
      console.log("Alou");
      var url = window.location.href.split( '/' );
      console.log(url);
      if(url[4]){
        var active_item = document.getElementById(url[4]);
        active_item?.classList.add("active");
      }
      else{
        var active_item = document.getElementById("home");
        active_item?.classList.add("active");
      }
    };
    activate();
  });
</script>
---
import { type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getLangFromUrl } from "../i18n/utils";

type Props = {
    post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
console.log(post.data.image)
console.log(post.id)
const [lang, ...slug] = post.id.split('/');
---

<article>
    <a href={`/${lang}/blog/${slug}`}>
        <Image
            src={post.data.image}
            width={600}
            height={600 / 1.5}
            alt={post.data.title}
            class="rounded-2xl shadow-xl mb-4 aspect-thumbnail object-cover"
        />
    </a>
    <a
        href={`/${lang}/blog/${slug}`}
        class="text-4xl text-zinc-900 font-semibold inline-block"
    >
        <h2>{post.data.title}</h2>
    </a>
    <div class="tags">
        {post.data.categories.map((tag: string) => (
        <p class="tag"><a href={`/${lang}/tags/${tag}`}>{tag}</a></p>
        ))}
    </div>
    <p class="text-zinc-500 text-2xl line-clamp-2">
        {post.body}
    </p>
</article>
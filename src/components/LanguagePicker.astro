---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
import blog  from "../data/blog.json";

function getIndex(aux: string, lang: string){
  var index = 0;
  var filteredObj = blog.find(function(item, i){
    if(lang == 'en'){
      if(item.en === aux){
        index = i
        return i;
      }
    }
    else{
      if(item.ptbr === aux){
        index = i
        return i;
      }
    }
  });
  if(!filteredObj){
    return index;
  }else{
    return index;
  }
}

function getPath(lang_org: string){
  let lang = getLangFromUrl(Astro.url);
  var url = Astro.url.pathname.split( '/' );
  var title = '';
  if(url.length > 3 && (url[2] == 'blog' || url[2] == 'portfolio' || url[2] == 'changelog') && url[3] != ''){
    var aux = url[3];
    if(lang_org == 'en'){
      var i = getIndex(aux, lang);
      title = blog[i].en;
    }else{
      var i = getIndex(aux, lang);
      title = blog[i].ptbr;
    }
    var string = Astro.url.pathname;
    string = string.replace(`/${lang}/`, '');
    string = string.replace(`/${url[3]}`, `/${title}`);
    return string;
  }
  return Astro.url.pathname.replace(`/${lang}/`, '');
}

---
<ul class="lg:flex-row lg:px-3 md:p-0 block font-bold text-gray-800 dark:text-gray-50 lg:w-auto">
  {Object.entries(languages).map(([lang, label]) => (
    <li>
      <a href={`/${lang}/${getPath(lang)}`} class="flex dark:hover:text-gray-300 hover:text-gray-500 bg-white hover:bg-amber-300 dark:bg-gray-800 dark:hover:bg-emerald-900 rounded-2xl px-3 max-lg:rounded-none">{label}</a>
    </li>
  ))}
</ul>
---
interface Link {
  name: string;
  url: string;
}

interface Props {
  name: string;
  // links: Link[];
}

const { name = 'Dropdown' } = Astro.props;
// , links = []
import Button from './Button.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
/*
Na hora de fazer genérico esse componente vou precisar disso, provavelmente:
    {
      links.map((link) => (
        <a
          href={link.url}
          class="m-1 block rounded-md px-2 py-2 text-sm text-slate-300/80 transition-colors duration-200 hover:bg-slate-700 hover:text-slate-200/95">
          {link.name}
        </a>
      ))
    }

*/

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

---

<div class="relative md:p-0 block">
  <Button name={t('nav.theme')} id="dropdown-button" showCaret={true} />
  <div
    id="dropdown"
    class="absolute mt-2 hidden text-balance rounded-md bg-slate-200 dark:bg-slate-800 p-[0.5px] sm:ml-2 md:w-25">
    <Button name={t('nav.dark')} id="dark-button" showCaret={false} />
    <Button name={t('nav.light')} id="light-button" showCaret={false} />
  </div>
</div>

<script>
  const button = document.getElementById('dropdown-button');
  const dropdown = document.getElementById('dropdown');
  const dark_button = document.getElementById('dark-button');
  const light_button = document.getElementById('light-button');

  button!.addEventListener('click', (event) => {
    dropdown!.classList.toggle('hidden');
    button!.classList.toggle('dropdown-active');
    event.stopPropagation();
  });

  document.addEventListener('click', () => {
    button!.classList.remove('dropdown-active');
    dropdown!.classList.add('hidden');
  });

  light_button!.addEventListener('click', (event) => {
    document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', 'light');
  });

  dark_button!.addEventListener('click', (event) => {
    document.documentElement.classList.add('dark');
    localStorage.setItem('theme', 'dark');
  });
</script>
---
import { Icon } from 'astro-icon/components';
---

<button type="button" aria-label="toggle dark/light mode" id="themeToggle">
  <span class="dark:hidden inline">
    <Icon name="feather:moon"></Icon>
  </span>
  <span class="dark:inline hidden">
    <Icon name="feather:sun"></Icon>
  </span>
</button>

<script>
  import { themeStore, THEME_MAP } from '../libs/stores/theme';

  document.addEventListener("astro:page-load", () => {
  // Get current theme from store
    let currentTheme = themeStore.get();
    
    // Apply initial theme to document
    if (currentTheme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    const handleToggleClick = () => {
      // Toggle between light and dark
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      
      // Update the store (this will also update localStorage if your store does that)
      themeStore.set(newTheme);
      
      // Update document class
      if (newTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      
      // Update current theme
      currentTheme = newTheme;
    };

    // Subscribe to store changes (in case theme is changed elsewhere)
    const unsubscribe = themeStore.subscribe((newTheme) => {
      currentTheme = newTheme;
      
      // Update document class when store changes
      if (newTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    });

    // Add click listener
    const themeToggle = document.getElementById('themeToggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', handleToggleClick);
    }

    // Cleanup on page navigation/refresh
    window.addEventListener('beforeunload', () => {
      unsubscribe();
      if (themeToggle) {
        themeToggle.removeEventListener('click', handleToggleClick);
      }
    });
  });
</script>